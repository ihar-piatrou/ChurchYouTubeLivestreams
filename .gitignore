# ---------------------------------------------------------------------------
# Secrets and credentials - these must never be committed
# ---------------------------------------------------------------------------
# Google OAuth credential files downloaded from Google Cloud Console.
# This application does NOT need them at runtime: ClientId/ClientSecret come
# from .NET User Secrets locally and from the platform secret store when hosted.
client_secret*.json
client_secrets*.json
credentials*.json
*oauth*credentials*.json
service-account*.json
token.json
tokens.json

# Local environment overrides
.env
.env.*
appsettings.Local.json
appsettings.*.Local.json
secrets.json

