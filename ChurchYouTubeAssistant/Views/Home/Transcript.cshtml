@model TranscriptViewModel
@{
    ViewData["Title"] = "Transcript";
}

<p><a href="/">&larr; Back to dashboard</a></p>

<h1>Transcript</h1>
<p class="muted">Video ID: @Model.VideoId</p>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

@if (Model.Transcript is { } transcript)
{
    <div class="card">
        <div class="status-row">
            <span>Language: <strong>@(transcript.Language ?? "unknown")</strong></span>
            <span class="muted">&middot;</span>
            <span>@(transcript.IsAutoGenerated ? "auto-generated (ASR)" : "manually created")</span>
            <span class="muted">&middot;</span>
            <span>format: @transcript.Format</span>
        </div>
    </div>
    <div class="transcript-box">@transcript.Content</div>
}
else if (Model.ErrorMessage is null)
{
    <p class="muted">No transcript content returned.</p>
}
