{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "ChurchYouTubeAssistant": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  // ClientId and ClientSecret deliberately live in .NET User Secrets, never here.
  // RedirectUri is not a secret, but it must match an authorised redirect URI on the
  // Google OAuth client byte for byte or Google returns redirect_uri_mismatch.
  "Google": {
    "RedirectUri": "https://localhost:5001/oauth2/callback"
  },

  // Windows Authentication against the local SQL Server Express instance - no password, so this
  // is safe to keep here rather than in User Secrets. If you use SQL authentication instead,
  // override this via User Secrets (dotnet user-secrets set "ConnectionStrings:DefaultConnection" "...")
  // so the password never lands in this file.
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS2019;Database=ChurchYouTubeAssistant;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  // The local HTTPS port is part of the registered redirect URI, so it is pinned here rather
  // than in launchSettings.json: this binds 5001 however the app is started (dotnet run,
  // dotnet exec, Visual Studio, VS Code, Rider).
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:5001"
      }
    }
  }
}
